{
  "openapi": "3.1.0",
  "info": {
    "title": "{{ service_name }}",
    "description": "OpenAPI spec for {{ service_name }} MFS microservice. Auto-generated by scaffold_mcp.py for EasyMCP and MCP client consumption.",
    "version": "{{ contract_version }}"
  },
  "servers": [
    {
      "url": "{{ default_base_url }}",
      "description": "Default MFS service endpoint"
    }
  ],
  "paths": {
    "{{ health_path }}": {
      "get": {
        "operationId": "health_check",
        "summary": "Health check for {{ service_name }}",
        "description": "Returns service health status, name, and contract version.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] },
                    "service": { "type": "string" },
                    "contract_version": { "type": "string" }
                  },
                  "required": ["status", "service", "contract_version"]
                }
              }
            }
          }
        }
      }
    },
    "{{ contract_path }}": {
      "get": {
        "operationId": "get_capabilities",
        "summary": "Get capabilities of {{ service_name }}",
        "description": "Returns contract metadata: version, supported operations, feature name, and service status.",
        {% if token_required %}
        "security": [{ "bearerAuth": [] }],
        {% endif %}
        "responses": {
          "200": {
            "description": "Capabilities payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contract_version": { "type": "string" },
                    "status": { "type": "string", "enum": {{ allowed_status_json }} },
                    "source": { "type": "string" },
                    "generated_at": { "type": "string", "format": "date-time" },
                    "feature": { "type": "string" },
                    "supports": { "type": "array", "items": { "type": "string" } },
                    "error": { "type": "string", "nullable": true }
                  },
                  "required": {{ required_fields_json }}
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }{% for endpoint in extra_endpoints %},
    "{{ endpoint.path }}": {
      "{{ endpoint.method | lower }}": {
        "operationId": "{{ endpoint.tool_name }}",
        "summary": "{{ endpoint.description }}",
        {% if token_required %}
        "security": [{ "bearerAuth": [] }],
        {% endif %}
        {% if endpoint.method == "POST" %}
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  {% for p in endpoint.params %}
                  "{{ p.name }}": { "type": "{{ p.openapi_type }}"{% if p.description %}, "description": "{{ p.description }}"{% endif %} }{% if not loop.last %},{% endif %}
                  {% endfor %}
                }
              }
            }
          }
        },
        {% endif %}
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }{% endfor %}
  }{% if token_required %},
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }{% endif %}
}
