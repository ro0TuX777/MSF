#!/usr/bin/env python3
"""MCP Server for {{ service_name }}.

Auto-generated by MFS scaffold_mcp.py.
Wraps the {{ service_name }} MFS service as MCP tools for AI agent consumption.

Usage:
  python server.py                          # stdio transport (default)
  python server.py --transport sse          # SSE transport on port {{ mcp_port }}
  python server.py --transport streamable-http  # Streamable HTTP on port {{ mcp_port }}

Environment:
  {{ env_prefix }}_BASE_URL   Service URL (default: {{ default_base_url }})
  {{ env_prefix }}_TOKEN      Bearer token (optional)
  MCP_TRANSPORT               Override transport: stdio | sse | streamable-http
  MCP_PORT                    Override SSE/HTTP port (default: {{ mcp_port }})
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any

try:
    import requests
except ImportError:
    print("ERROR: 'requests' is required. Install with: pip install requests", file=sys.stderr)
    sys.exit(1)

try:
    from mcp.server.fastmcp import FastMCP
except ImportError:
    print("ERROR: 'mcp' SDK is required. Install with: pip install mcp", file=sys.stderr)
    sys.exit(1)


# ── Configuration ─────────────────────────────────────────────────

SERVICE_NAME = "{{ service_name }}"
DEFAULT_BASE_URL = os.getenv("{{ env_prefix }}_BASE_URL", "{{ default_base_url }}")
TOKEN = os.getenv("{{ env_prefix }}_TOKEN", "")
TIMEOUT_S = float(os.getenv("{{ env_prefix }}_TIMEOUT_S", "10"))

mcp = FastMCP(
    "{{ service_name }}",
    instructions=(
        "MCP server wrapping the {{ service_name }} MFS microservice. "
        "Use these tools to interact with the {{ feature_name }} feature."
    ),
)


def _headers() -> dict[str, str]:
    h = {"Accept": "application/json", "Content-Type": "application/json"}
    if TOKEN:
        h["Authorization"] = f"Bearer {TOKEN}"
    return h


def _base_url() -> str:
    return DEFAULT_BASE_URL.rstrip("/")


# ── MCP Tools ─────────────────────────────────────────────────────

@mcp.tool()
def health_check() -> str:
    """Check the health status of the {{ service_name }} service.

    Returns the service health payload including status, service name,
    and contract version.
    """
    try:
        resp = requests.get(
            f"{_base_url()}{{ health_path }}",
            headers=_headers(),
            timeout=TIMEOUT_S,
        )
        resp.raise_for_status()
        return json.dumps(resp.json(), indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc), "status": "unavailable"})


@mcp.tool()
def get_capabilities() -> str:
    """Discover the capabilities of the {{ service_name }} service.

    Returns the contract metadata including version, supported operations,
    and current service status.
    """
    try:
        resp = requests.get(
            f"{_base_url()}{{ contract_path }}",
            headers=_headers(),
            timeout=TIMEOUT_S,
        )
        resp.raise_for_status()
        return json.dumps(resp.json(), indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc), "status": "unavailable"})

{% for endpoint in extra_endpoints %}

@mcp.tool()
def {{ endpoint.tool_name }}({{ endpoint.params_signature }}) -> str:
    """{{ endpoint.description }}
    {% for p in endpoint.params %}
    Args:
        {{ p.name }}: {{ p.description }}
    {% endfor %}
    """
    try:
        {% if endpoint.method == "POST" %}
        payload: dict[str, Any] = {{ endpoint.payload_builder }}
        resp = requests.post(
            f"{_base_url()}{{ endpoint.path }}",
            headers=_headers(),
            json=payload,
            timeout=TIMEOUT_S,
        )
        {% else %}
        params: dict[str, Any] = {{ endpoint.params_builder }}
        resp = requests.get(
            f"{_base_url()}{{ endpoint.path }}",
            headers=_headers(),
            params=params,
            timeout=TIMEOUT_S,
        )
        {% endif %}
        resp.raise_for_status()
        return json.dumps(resp.json(), indent=2)
    except Exception as exc:
        return json.dumps({"error": str(exc), "status": "unavailable"})
{% endfor %}


# ── MCP Resources ────────────────────────────────────────────────

@mcp.resource("service://{{ feature_slug }}/contract")
def contract_resource() -> str:
    """The MFS contract definition for {{ service_name }}."""
    return json.dumps({{ contract_json }}, indent=2)


@mcp.resource("service://{{ feature_slug }}/info")
def service_info() -> str:
    """Service metadata for {{ service_name }}."""
    return json.dumps({
        "service_name": SERVICE_NAME,
        "base_url": _base_url(),
        "feature": "{{ feature_name }}",
        "mcp_generator": "mfs_scaffold_mcp",
    }, indent=2)


# ── Entrypoint ───────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(description=f"MCP Server for {SERVICE_NAME}")
    parser.add_argument(
        "--transport",
        choices=["stdio", "sse", "streamable-http"],
        default=os.getenv("MCP_TRANSPORT", "stdio"),
        help="MCP transport (default: stdio)",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=int(os.getenv("MCP_PORT", "{{ mcp_port }}")),
        help="Port for SSE/HTTP transport (default: {{ mcp_port }})",
    )
    args = parser.parse_args()

    if args.transport == "stdio":
        mcp.run(transport="stdio")
    elif args.transport == "sse":
        mcp.run(transport="sse", sse_params={"port": args.port})
    elif args.transport == "streamable-http":
        mcp.run(transport="streamable-http", streamable_http_params={"port": args.port})


if __name__ == "__main__":
    main()
