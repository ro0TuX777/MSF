{% endif %}
{% endfor %}
        }
{% for param in action.parameters %}
{% if not param.required %}
        if {{ param.name }} is not None:
            payload["{{ param.name }}"] = {{ param.name }}
{% endif %}
{% endfor %}
        return self._request("{{ action.method }}", "{{ action.endpoint }}", json_body=payload)
