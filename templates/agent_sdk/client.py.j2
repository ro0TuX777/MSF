{% if governance_mode == "full" %}
    # ═══════════════════════════════════════════════════════════════
    # GOVERNANCE INTROSPECTION
    # ═══════════════════════════════════════════════════════════════

    def available_actions(
        self,
        family: str | None = None,
        tag: str | None = None,
    ) -> List[Dict[str, Any]]:
        """List actions available to the current session."""
        sid = self.ensure_session()
        params: Dict[str, Any] = {"session_id": sid}
        if family:
            params["action_family"] = family
        if tag:
            params["tag"] = tag
        body = self._request("GET", "/actions", params=params)
        return body.get("available_actions", [])

    def budget_status(self) -> Dict[str, Any]:
        """Check remaining budget and circuit breaker state."""
        sid = self.ensure_session()
        return self._request("GET", "/budget/status", params={"session_id": sid})

    def receipts(self) -> List[Dict[str, Any]]:
        """Get the audit trail for the current session."""
        sid = self.ensure_session()
        body = self._request("GET", f"/receipts/{sid}")
        return body.get("receipts", [])

{% endif %}
    # ═══════════════════════════════════════════════════════════════
    # HEALTH CHECK
    # ═══════════════════════════════════════════════════════════════

    def health(self) -> bool:
        """Check if {{ app_name }} is reachable and responding.

        Returns ``True`` if the host responds, ``False`` otherwise.
        Does NOT require an active session.
        """
        try:
            resp = self._http.get(
                f"{self._base}{{ health_endpoint }}",
                timeout=min(self._cfg.timeout_s, 5.0),
            )
            return resp.status_code == 200
        except (requests.ConnectionError, requests.Timeout):
            return False

    # ═══════════════════════════════════════════════════════════════
    # CONTEXT MANAGER
    # ═══════════════════════════════════════════════════════════════

    def __enter__(self) -> "{{ app_pascal }}Client":
{% if governance_mode != "stateless" %}
        self.ensure_session()
{% endif %}
        return self

    def __exit__(self, *exc_info) -> None:
        self._http.close()

    def __repr__(self) -> str:
        return (
            "{{ app_pascal }}Client(base_url={base!r}, "
{% if governance_mode != "stateless" %}
            "session_id={sid!r}, "
{% endif %}
            "agent_class={agent!r})"
        ).format(
            base=self._base,
{% if governance_mode != "stateless" %}
            sid=self._session_id,
{% endif %}
            agent=self._cfg.agent_class,
        )
