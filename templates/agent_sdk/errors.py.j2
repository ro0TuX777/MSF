"""{{ app_name }} SDK exceptions — typed errors with agent_should guidance."""

from __future__ import annotations

from typing import Any, Dict, Optional


class {{ app_pascal }}Error(Exception):
    """Base exception for all {{ app_name }} SDK errors."""

    def __init__(
        self,
        code: str,
        message: str,
        agent_should: str = "",
        details: Optional[Dict[str, Any]] = None,
    ):
        self.code = code
        self.message = message
        self.agent_should = agent_should
        self.details = details or {}
        super().__init__(f"[{code}] {message}")

    def to_dict(self) -> Dict[str, Any]:
        return {
            "code": self.code,
            "message": self.message,
            "agent_should": self.agent_should,
            "details": self.details,
        }


{% if governance_mode != "stateless" %}
# ── Session errors ────────────────────────────────────────────────

class SessionExpiredError({{ app_pascal }}Error):
    """Session TTL has elapsed.  Agent should create a new session."""

    def __init__(self, message: str = "Session has expired", **kw):
        super().__init__(
            code="SESSION_EXPIRED",
            message=message,
            agent_should="Create a new session via client.ensure_session(force=True)",
            **kw,
        )


class SessionNotFoundError({{ app_pascal }}Error):
    """Session ID does not exist."""

    def __init__(self, message: str = "Session not found", **kw):
        super().__init__(
            code="SESSION_NOT_FOUND",
            message=message,
            agent_should="Create a new session — the previous one may have been cleaned up",
            **kw,
        )

