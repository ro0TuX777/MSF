# ── Error code → exception class mapping ─────────────────────────

_CODE_MAP: Dict[str, type] = {
{% if governance_mode != "stateless" %}
    "SESSION_EXPIRED": SessionExpiredError,
    "SESSION_NOT_FOUND": SessionNotFoundError,
{% endif %}
{% if governance_mode == "full" %}
    "BUDGET_EXCEEDED": BudgetExceededError,
    "CIRCUIT_OPEN": CircuitOpenError,
    "TRUST_INSUFFICIENT": TrustInsufficientError,
    "GUARD_FAILED": GuardFailedError,
{% endif %}
{% for error in custom_errors %}
    "{{ error.code }}": {{ error.exception }},
{% endfor %}
    "ACTION_NOT_FOUND": ActionNotFoundError,
    "INVALID_PARAMETERS": InvalidParametersError,
    "EXECUTION_FAILED": ExecutionFailedError,
}

# ── HTTP status code fallback map ─────────────────────────────────

_STATUS_MAP: Dict[int, type] = {
    400: InvalidParametersError,
    404: ActionNotFoundError,
    429: {{ app_pascal }}Error,  # Rate limited
    500: ExecutionFailedError,
    503: ServiceUnavailableError,
}


def raise_for_error(response_json: Dict[str, Any]) -> None:
    """Inspect a response and raise the appropriate typed exception.

    If ``response_json["ok"]`` is ``True`` this is a no-op.
    """
    if response_json.get("ok"):
        return

    error = response_json.get("error", {})
    if isinstance(error, str):
        raise {{ app_pascal }}Error(code="UNKNOWN", message=error)

    code = error.get("code", "UNKNOWN") if isinstance(error, dict) else "UNKNOWN"
    message = error.get("message", str(error)) if isinstance(error, dict) else str(error)

    exc_cls = _CODE_MAP.get(code, {{ app_pascal }}Error)
    if exc_cls is {{ app_pascal }}Error:
        raise exc_cls(code=code, message=message, details={"raw_error": error})
    raise exc_cls(message=message, details={"raw_error": error})


def raise_for_status(status_code: int, response_body: Any = None) -> None:
    """Raise from HTTP status code when no structured error body is available."""
    if 200 <= status_code < 300:
        return
    exc_cls = _STATUS_MAP.get(status_code, {{ app_pascal }}Error)
    message = str(response_body) if response_body else f"HTTP {status_code}"
    if exc_cls is {{ app_pascal }}Error:
        raise exc_cls(code=f"HTTP_{status_code}", message=message)
    raise exc_cls(message=message)
