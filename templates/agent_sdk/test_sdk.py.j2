class TestClientSession:
    """Client session creation, refresh, and auto-retry."""

    def _mock_response(self, json_data, status_code=200):
        resp = MagicMock(spec=requests.Response)
        resp.json.return_value = json_data
        resp.status_code = status_code
        return resp

    def test_ensure_session_creates_new(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://fake:{{ default_port }}")
        mock_resp = self._mock_response({
            "ok": True, "{{ session_id_field }}": "sess-123",
            "agent_class": "default_agent",
        })
        with patch.object(client._http, "request", return_value=mock_resp):
            sid = client.ensure_session()
        assert sid == "sess-123"
        assert client.session_id == "sess-123"

    def test_ensure_session_reuses_existing(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://fake:{{ default_port }}")
        client._session_id = "existing-session"
        sid = client.ensure_session()
        assert sid == "existing-session"

    def test_ensure_session_force_creates_new(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://fake:{{ default_port }}")
        client._session_id = "old-session"
        mock_resp = self._mock_response({
            "ok": True, "{{ session_id_field }}": "new-sess",
            "agent_class": "default_agent",
        })
        with patch.object(client._http, "request", return_value=mock_resp):
            sid = client.ensure_session(force=True)
        assert sid == "new-sess"

    def test_auto_session_on_expired(self):
        """Client should auto-create a new session when the old one expires."""
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://fake:{{ default_port }}")
        client._session_id = "expired-sess"

        call_count = [0]

        def side_effect(method, url, **kwargs):
            call_count[0] += 1
            if call_count[0] == 1:
                return self._mock_response({
                    "ok": False,
                    "error": {"code": "SESSION_EXPIRED", "message": "Expired"},
                })
            elif call_count[0] == 2:
                return self._mock_response({
                    "ok": True, "{{ session_id_field }}": "new-sess",
                    "agent_class": "default_agent",
                })
            else:
                return self._mock_response({
                    "ok": True, "data": {"result": "success"},
                })

        with patch.object(client._http, "request", side_effect=side_effect):
            result = client.submit_intent("test_action", {"key": "value"})
        assert result["ok"]
        assert client.session_id == "new-sess"

    def test_refresh_session(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://fake:{{ default_port }}")
        client._session_id = "sess-abc"
        mock_resp = self._mock_response({
            "ok": True, "{{ session_id_field }}": "sess-abc",
            "extensions_count": 1,
        })
        with patch.object(client._http, "request", return_value=mock_resp):
            result = client.refresh_session()
        assert result["ok"]

