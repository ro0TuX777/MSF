# TIER 4: Graceful Degradation
# ═══════════════════════════════════════════════════════════════════

class TestGracefulDegradation:

    def test_connection_error_raises_service_unavailable(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        from {{ app_slug }}_sdk.errors import ServiceUnavailableError
        client = {{ app_pascal }}Client("http://unreachable:{{ default_port }}")
        client._cfg.retries = 0
        client._cfg.retry_delay_s = 0
        with patch.object(
            client._http, "request",
            side_effect=requests.ConnectionError("refused"),
        ):
            with pytest.raises(ServiceUnavailableError) as exc_info:
                client._request("GET", "/health")
            assert "unreachable" in str(exc_info.value)

    def test_timeout_raises_service_unavailable(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        from {{ app_slug }}_sdk.errors import ServiceUnavailableError
        client = {{ app_pascal }}Client("http://slow:{{ default_port }}")
        client._cfg.retries = 0
        client._cfg.retry_delay_s = 0
        with patch.object(
            client._http, "request",
            side_effect=requests.Timeout("timed out"),
        ):
            with pytest.raises(ServiceUnavailableError):
                client._request("GET", "/health")

    def test_health_returns_false_on_failure(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://down:{{ default_port }}")
        with patch.object(
            client._http, "get",
            side_effect=requests.ConnectionError("refused"),
        ):
            assert client.health() is False

    def test_health_returns_true_on_success(self):
        from {{ app_slug }}_sdk import {{ app_pascal }}Client
        client = {{ app_pascal }}Client("http://up:{{ default_port }}")
        mock_resp = MagicMock()
        mock_resp.status_code = 200
        with patch.object(client._http, "get", return_value=mock_resp):
            assert client.health() is True


