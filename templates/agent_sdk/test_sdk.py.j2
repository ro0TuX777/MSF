class Test{{ app_pascal }}Config:
    def test_defaults(self):
        from {{ app_slug }}_sdk.config import {{ app_pascal }}Config
        cfg = {{ app_pascal }}Config()
        assert cfg.base_url == "http://localhost:{{ default_port }}"
        assert cfg.agent_class == "default_agent"
        assert cfg.timeout_s == 30.0
        assert cfg.retries == 2

    def test_from_env(self, monkeypatch):
        from {{ app_slug }}_sdk.config import {{ app_pascal }}Config
        monkeypatch.setenv("{{ app_upper }}_BASE_URL", "http://custom:9000")
        monkeypatch.setenv("{{ app_upper }}_AGENT_CLASS", "my_agent")
        monkeypatch.setenv("{{ app_upper }}_TIMEOUT_S", "15")
        monkeypatch.setenv("{{ app_upper }}_RETRIES", "5")
        cfg = {{ app_pascal }}Config.from_env()
        assert cfg.base_url == "http://custom:9000"
        assert cfg.agent_class == "my_agent"
        assert cfg.timeout_s == 15.0
        assert cfg.retries == 5

    def test_explicit_base_url_overrides_env(self, monkeypatch):
        from {{ app_slug }}_sdk.config import {{ app_pascal }}Config
        monkeypatch.setenv("{{ app_upper }}_BASE_URL", "http://from-env:9000")
        cfg = {{ app_pascal }}Config(base_url="http://explicit:8000")
        assert cfg.base_url == "http://explicit:8000"


